       "kind": {
        "type": "string",
        "enum": [
         "quote",
         "arithmetic",
         "evidence"
        ]
       },
       "sceneIndex": {
        "type": "integer"
       },
       "from": {
        "type": "string"
       },
       "ref": {
        "type": "string"
       }
      },
      "required": [
       "kind"
      ],
      "additionalProperties": true
     },
