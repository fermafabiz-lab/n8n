{
 "type": "object",
 "properties": {
  "none_because": {
   "type": "string",
   "description": "When cards is empty: one line naming what the film DID offer that no motif could draw."
  },
  "cards": {
   "type": "array",
   "description": "0-3 drawn cards. Only the four common fields are required; each variant carries its own list (marks / stops / rows / sides / steps).",
   "items": {
    "type": "object",
    "properties": {
     "sceneIndex": {
      "type": "integer",
      "description": "The scene the card is cut into."
     },
     "variant": {
      "type": "string",
      "enum": [
       "route",
       "schedule",
       "timeline",
       "compare",
       "steps"
      ]
     },
     "priority": {
      "type": "integer",
      "description": "1 is best."
     },
     "why": {
      "type": "string",
      "description": "One line: what this shows that the voice and the shot do not."
     },
     "label": {
      "type": "string",
      "description": "Optional short word naming the graphic. No digits, max 12 chars."
     },
     "note": {
      "type": "string",
      "description": "Optional. The one thing the footage cannot say."
     },
     "noteSource": {
      "type": "object",
      "description": "quote {kind,sceneIndex,from} | arithmetic {kind} | evidence {kind,ref}",
