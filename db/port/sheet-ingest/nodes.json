    { "name": "Ingest Sheets", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-400, 96], "onError": "continueRegularOutput",
      "credentials": { "httpHeaderAuth": { "id": "8kpY42LmZaBYBzfY", "name": "HOV Media Ingest" } },
      "parameters": { "method": "POST", "url": "http://web:3000/api/media/ingest", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ field: \"sheets\", projectId: $json.projectId, items: $json.items }) }}", "options": { "timeout": 180000 } } },
    { "name": "Plate Ingest Prep", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-560, -160], "parameters": { "jsCode": "<paste/Plate Ingest Prep.js>" } },
    { "name": "Plate Ingest?", "type": "n8n-nodes-base.if", "typeVersion": 2.3, "position": [-400, -160],
      "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 3 }, "conditions": [ { "id": "plate-ingest-has-work", "leftValue": "={{ !$json.skip }}", "rightValue": "", "operator": { "type": "boolean", "operation": "true", "singleValue": true } } ], "combinator": "and" }, "options": {} } },
    { "name": "Ingest Plates", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-240, -160], "onError": "continueRegularOutput",
      "credentials": { "httpHeaderAuth": { "id": "8kpY42LmZaBYBzfY", "name": "HOV Media Ingest" } },
      "parameters": { "method": "POST", "url": "http://web:3000/api/media/ingest", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ field: \"sheets\", projectId: $json.projectId, items: $json.items }) }}", "options": { "timeout": 180000 } } }
  ],
  "connections": {
