{
  "name": "video-automation-remotion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "remotion studio src/index.ts",
    "studio": "node scripts/studio.mjs",
    "render": "remotion render src/index.ts FinalVideo out/final-video.mp4",
    "check": "npm run check:montage && npm run check:captions && npm run check:mix && npm run check:hook && npm run check:cards && node motif/check-motif.mjs motif/boyd-props.json motif/candidate-timeline.json && node motif/check-teaser.mjs && npm run check:watermark && npm run check:sar && npm run check:shim && npm run check:motion && npm run check:transitions && npm run check:graphics",
    "check:montage": "node --experimental-strip-types scripts/check-montage.mjs",
    "check:captions": "node --experimental-strip-types scripts/check-captions.mjs",
    "check:mix": "node scripts/check-mix.mjs",
    "check:hook": "node --experimental-strip-types scripts/check-hook.mjs",
    "check:motif": "node motif/check-motif.mjs",
    "start:server": "node server/index.mjs",
    "lambda:deploy-function": "remotion lambda functions deploy",
    "lambda:deploy-site": "remotion lambda sites create src/index.ts --site-name=final-video",
    "check:watermark": "node --experimental-strip-types scripts/check-watermark.mjs",
    "check:sar": "node scripts/check-sar.mjs",
    "check:cards": "node --experimental-strip-types scripts/check-cards.mjs",
    "check:shim": "node scripts/check-shim.mjs",
    "render:local": "node scripts/render-local.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:transitions": "node scripts/check-transitions.mjs",
    "check:graphics": "node scripts/check-graphics.mjs"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/league-gothic": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@hyperframes/producer": "0.8.72",
    "@remotion/bundler": "4.0.489",
    "@remotion/cli": "4.0.489",
    "@remotion/google-fonts": "4.0.489",
    "@remotion/lambda": "4.0.489",
    "@remotion/renderer": "4.0.489",
    "cors": "^2.8.5",
    "esbuild": "^0.28.2",
    "express": "^4.21.0",
    "gsap": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.489"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.4.0"
  }
}
