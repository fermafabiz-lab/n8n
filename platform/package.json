{
  "name": "video-factory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "npm run check:review && npm run check:cost && npm run check:provenance && npm run check:normalize && npm run check:validation && npm run check:routes && npm run check:footage && npm run check:kenburns && npm run check:series && npm run check:regen-wait && npm run check:deeplink && npm run check:deepsearch && npm run check:recap && npm run check:script-headers",
    "check:review": "node --experimental-strip-types scripts/check-review.mjs",
    "check:cost": "node --experimental-strip-types scripts/check-cost.mjs",
    "check:provenance": "node --experimental-strip-types scripts/check-provenance.mjs",
    "check:style-refs": "node --experimental-strip-types scripts/check-style-refs.mjs",
    "check:normalize": "node --experimental-strip-types --no-warnings --import ./scripts/alias-loader.mjs scripts/check-normalize.mjs",
    "check:validation": "node --experimental-strip-types --no-warnings scripts/check-validation.mjs",
    "check:routes": "node --experimental-strip-types --no-warnings --import ./scripts/alias-loader.mjs scripts/check-routes.mjs",
    "check:footage": "node --experimental-strip-types --no-warnings --import ./scripts/footage-loader.mjs scripts/check-footage.mjs",
    "check:kenburns": "node --experimental-strip-types scripts/check-kenburns.mjs",
    "check:deeplink": "node --experimental-strip-types --no-warnings scripts/check-deeplink.mjs",
    "check:created-by": "node --experimental-strip-types --no-warnings --import ./scripts/footage-loader.mjs scripts/check-created-by.mjs",
    "check:series": "node --experimental-strip-types --no-warnings --import ./scripts/alias-loader.mjs scripts/check-series.mjs",
    "check:regen-wait": "node --experimental-strip-types --no-warnings --import ./scripts/alias-loader.mjs scripts/check-regen-wait.mjs",
    "check:deepsearch": "node --experimental-strip-types --no-warnings --import ./scripts/alias-loader.mjs scripts/check-deep-search.mjs",
    "check:recap": "node ../db/port/series-recap/check.mjs",
    "check:script-headers": "node ../db/port/script-headers/check.mjs"
  },
  "dependencies": {
    "next": "^15.3.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
