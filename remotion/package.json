{
  "name": "video-automation-remotion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "remotion studio src/index.ts",
    "studio": "node scripts/studio.mjs",
    "render": "remotion render src/index.ts FinalVideo out/final-video.mp4",
    "check:montage": "node --experimental-strip-types scripts/check-montage.mjs",
    "start:server": "node server/index.mjs",
    "lambda:deploy-function": "remotion lambda functions deploy",
    "lambda:deploy-site": "remotion lambda sites create src/index.ts --site-name=final-video"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.489",
    "@remotion/cli": "4.0.489",
    "@remotion/lambda": "4.0.489",
    "@remotion/renderer": "4.0.489",
    "@remotion/bundler": "4.0.489",
    "@remotion/google-fonts": "4.0.489",
    "express": "^4.21.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/react": "^18.3.1",
    "@types/node": "^20.0.0"
  }
}
